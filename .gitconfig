[url "git@github.com:"]
    insteadOf = https://github.com/
    insteadOf = gh:
[url "git@codeberg.org:"]
    insteadOf = https://codeberg.org/
    insteadOf = cb:
[url "git@tangled.org:"]
    insteadOf = https://tangled.org/
    insteadOf = tg:
[user]
    email = rudbsm@gmail.com
    name = Nick
    signkey = ~/.ssh/id_ed25519.pub
    signingkey = ~/.ssh/git_signing
[alias]
    tree = log --graph --oneline --decorate --all --max-count=30
    recent = log --oneline --decorate -10
[init]
    defaultBranch = master
[push]
    autoSetupRemote = true
    default = simple
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[core]
	quotePath = false
[gpg]
	format = ssh
[commit]
	gpgsign = true
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
